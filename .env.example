# Copy to .env on the droplet (deploy/deploy.sh does this and generates the
# secrets). Never commit the filled-in file.

# --- required ---
# Self-hosted Postgres from /opt/postgres. `postgres` is the container hostname
# on the shared postgres_default network; the port is never published publicly.
DATABASE_URL=postgresql://prismona:change-me@postgres:5432/prismona
DATABASE_SSL=off                      # local non-TLS Postgres over the docker network
AUTH_SECRET=change-me                 # HMAC for sessions + pseudonymous account/observe keys
PRISMONA_BASE_URL=https://prismona.io

# --- optional tuning ---
# PG_POOL_MAX=5                       # connections per app instance (server allows 50 total)
# OBS_RETENTION_DAYS=180              # observed-layer age-out; 0 disables
